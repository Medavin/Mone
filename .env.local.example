# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). .env.local is gitignored.

# e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# The "anon" / publishable key. Safe to expose to the browser — access control
# is enforced by row-level security policies on the database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
